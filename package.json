{
  "name": "barnroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=23.6" },
  "scripts": {
    "build": "esbuild client/engine.ts --bundle --format=esm --outfile=public/engine.js",
